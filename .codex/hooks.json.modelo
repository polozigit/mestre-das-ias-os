{
  "description": "Hooks da Casa: confere o estado ao abrir a sessão, guarda as ferramentas e salva o trabalho ao parar.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{CASA_ABS}}/.codex/hooks/verificar_estado.py\" --evento startup",
            "commandWindows": "py -3 \"{{CASA_ABS}}\\.codex\\hooks\\verificar_estado.py\" --evento startup",
            "timeout": 25,
            "statusMessage": "Conferindo a Casa..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{CASA_ABS}}/.codex/hooks/verificar_estado.py\" --evento compact",
            "commandWindows": "py -3 \"{{CASA_ABS}}\\.codex\\hooks\\verificar_estado.py\" --evento compact",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{CASA_ABS}}/.codex/hooks/guarda.py\"",
            "commandWindows": "py -3 \"{{CASA_ABS}}\\.codex\\hooks\\guarda.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{CASA_ABS}}/.codex/hooks/registro_trabalho.py\" inicio",
            "commandWindows": "py -3 \"{{CASA_ABS}}\\.codex\\hooks\\registro_trabalho.py\" inicio",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{CASA_ABS}}/.codex/hooks/registro_trabalho.py\" fim",
            "commandWindows": "py -3 \"{{CASA_ABS}}\\.codex\\hooks\\registro_trabalho.py\" fim",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{CASA_ABS}}/.codex/hooks/autosave.py\"",
            "commandWindows": "py -3 \"{{CASA_ABS}}\\.codex\\hooks\\autosave.py\"",
            "timeout": 120,
            "statusMessage": "Salvando o trabalho..."
          }
        ]
      }
    ]
  }
}
